<view class="tab-bar">
  <view 
    class="tab-bar-item" 
    wx:for="{{list}}" 
    wx:key="index" 
    data-path="{{item.pagePath}}" 
    data-index="{{index}}" 
    bindtap="switchTab"
  >
    <view class="icon-wrapper">
      <view class="tab-icon {{selected === index ? 'selected' : ''}}">{{item.icon}}</view>
      <view wx:if="{{index === 3 && unreadCount > 0}}" class="badge">
        <text class="badge-text">{{unreadCount > 99 ? '99+' : unreadCount}}</text>
      </view>
    </view>
    <view class="tab-text" style="color: {{selected === index ? selectedColor : color}}">{{item.text}}</view>
  </view>
</view>
