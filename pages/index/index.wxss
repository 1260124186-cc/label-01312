/* pages/index/index.wxss */

.index-page {
  min-height: 100vh;
  background-color: var(--bg-color);
  padding-bottom: 120rpx;
}

/* 搜索栏 */
.search-bar {
  background-color: #ffffff;
  padding: 20rpx;
  position: sticky;
  top: 0;
  z-index: 100;
}

.search-box {
  display: flex;
  align-items: center;
  background-color: var(--bg-color);
  border-radius: 40rpx;
  padding: 16rpx 24rpx;
}

.search-icon {
  font-size: 28rpx;
  margin-right: 12rpx;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
}

/* 标签切换 */
.tab-bar {
  display: flex;
  background-color: #ffffff;
  border-bottom: 1rpx solid var(--border-color);
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 24rpx 0;
  font-size: 30rpx;
  color: var(--text-regular);
  position: relative;
  transition: all 0.3s ease;
}

.tab-item.active {
  color: var(--primary-color);
  font-weight: 600;
}

.tab-item.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 60rpx;
  height: 6rpx;
  background-color: var(--primary-color);
  border-radius: 3rpx;
}

/* 分类滚动 */
.category-scroll {
  background-color: #ffffff;
  white-space: nowrap;
  padding: 20rpx;
  margin-bottom: 20rpx;
}

.category-item {
  display: inline-block;
  padding: 12rpx 28rpx;
  margin-right: 16rpx;
  background-color: var(--bg-color);
  border-radius: 30rpx;
  font-size: 26rpx;
  color: var(--text-regular);
  transition: all 0.3s ease;
}

.category-item.active {
  background-color: var(--primary-color);
  color: #ffffff;
}

/* 技能列表 */
.skill-list {
  padding: 0 20rpx 20rpx;
}

.skill-card {
  background-color: #ffffff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05);
}

.skill-card:active {
  opacity: 0.9;
}

/* 卡片头部 */
.card-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.user-info {
  display: flex;
  align-items: center;
}

.avatar-wrapper {
  width: 80rpx;
  height: 80rpx;
  margin-right: 16rpx;
}

.avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background-color: var(--bg-color);
}

.avatar-default {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background-color: var(--bg-color);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
}

.user-detail {
  display: flex;
  flex-direction: column;
}

.nickname {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--text-primary);
  margin-bottom: 6rpx;
}

.meta-info {
  display: flex;
  align-items: center;
  font-size: 22rpx;
  color: var(--text-secondary);
}

.campus {
  margin-right: 16rpx;
}

.type-tag {
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
}

.type-tag.skill {
  background-color: rgba(103, 194, 58, 0.1);
  color: var(--secondary-color);
}

.type-tag.need {
  background-color: rgba(230, 162, 60, 0.1);
  color: var(--warning-color);
}

/* 卡片内容 */
.card-content {
  margin-bottom: 20rpx;
}

.title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-primary);
  display: block;
  margin-bottom: 12rpx;
}

.description {
  font-size: 26rpx;
  color: var(--text-regular);
  line-height: 1.6;
}

/* 卡片底部 */
.card-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-top: 16rpx;
  border-top: 1rpx solid var(--border-color);
}

.tags {
  display: flex;
  align-items: center;
}

.tag {
  display: inline-block;
  padding: 6rpx 16rpx;
  border-radius: 16rpx;
  font-size: 22rpx;
  margin-right: 12rpx;
}

.tag.category {
  background-color: rgba(74, 144, 217, 0.1);
  color: var(--primary-color);
}

.tag.duration {
  background-color: rgba(144, 147, 153, 0.1);
  color: var(--text-secondary);
}

.credit-score {
  display: flex;
  align-items: center;
}

.credit-score .label {
  font-size: 22rpx;
  color: var(--text-secondary);
  margin-right: 8rpx;
}

.credit-score .score {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--primary-color);
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100rpx 40rpx;
}

.empty-icon {
  font-size: 100rpx;
  margin-bottom: 30rpx;
}

.empty-text {
  font-size: 28rpx;
  color: var(--text-secondary);
  margin-bottom: 30rpx;
}

.empty-btn {
  background-color: var(--primary-color);
  color: #ffffff;
  font-size: 28rpx;
  padding: 16rpx 60rpx;
  border-radius: 40rpx;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
}

.empty-btn::after {
  border: none;
}

/* 加载状态 */
.loading-state {
  text-align: center;
  padding: 30rpx;
}

.loading-text {
  font-size: 26rpx;
  color: var(--text-secondary);
}

/* 没有更多 */
.no-more {
  text-align: center;
  padding: 30rpx;
}

.no-more text {
  font-size: 24rpx;
  color: var(--text-secondary);
}
