/* pages/evaluate/evaluate.wxss */

.evaluate-page {
  min-height: 100vh;
  background-color: var(--bg-color);
  padding: 20rpx;
}

/* 已评价提示 */
.evaluated-tip {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100rpx 40rpx;
  background-color: #ffffff;
  border-radius: 16rpx;
}

.tip-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.tip-text {
  font-size: 30rpx;
  color: var(--text-primary);
}

/* 评价表单 */
.evaluate-form {
  background-color: #ffffff;
  border-radius: 16rpx;
  padding: 30rpx;
}

/* 预约信息 */
.appointment-info {
  padding: 20rpx;
  background-color: var(--bg-color);
  border-radius: 12rpx;
  margin-bottom: 30rpx;
}

.info-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-primary);
  display: block;
  margin-bottom: 8rpx;
}

.info-time {
  font-size: 24rpx;
  color: var(--text-secondary);
}

/* 表单区块 */
.form-section {
  margin-bottom: 36rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--text-primary);
  margin-bottom: 20rpx;
  display: block;
}

/* 评分星星 */
.rating-stars {
  display: flex;
  justify-content: center;
  align-items: center;
  margin-bottom: 20rpx;
}

.star {
  padding: 0 12rpx;
  font-size: 56rpx;
  line-height: 1.2;
  color: #DCDFE6;
  transition: all 0.2s ease;
}

.star.active {
  color: #F7BA2A;
}

.rating-text {
  text-align: center;
  font-size: 26rpx;
  color: var(--text-secondary);
  display: block;
  margin-top: 8rpx;
}

/* 标签选择 */
.tag-list {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.tag-item {
  padding: 16rpx 28rpx;
  background-color: var(--bg-color);
  border-radius: 30rpx;
  font-size: 26rpx;
  color: var(--text-regular);
  border: 2rpx solid transparent;
  transition: all 0.3s ease;
}

.tag-item.selected {
  background-color: rgba(74, 144, 217, 0.1);
  border-color: var(--primary-color);
  color: var(--primary-color);
}

/* 评价内容输入 */
.comment-input {
  width: 100%;
  min-height: 200rpx;
  background-color: var(--bg-color);
  border-radius: 12rpx;
  padding: 24rpx;
  font-size: 28rpx;
  box-sizing: border-box;
  line-height: 1.6;
}

.input-tip {
  text-align: right;
  font-size: 22rpx;
  color: var(--text-secondary);
  margin-top: 8rpx;
}

/* 提交按钮 */
.submit-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 80%;
  height: 96rpx;
  line-height: 96rpx;
  background: linear-gradient(135deg, #4A90D9 0%, #67B8DE 100%);
  color: #ffffff;
  font-size: 32rpx;
  font-weight: 500;
  border-radius: 48rpx;
  border: none;
  margin: 40rpx auto 0;
  text-align: center;
}

.submit-btn::after {
  border: none;
}

.submit-btn.disabled {
  opacity: 0.6;
}

/* ========== 查看评价列表模式 ========== */

/* 评价概览卡片 - 新样式 */
.overview-card-new {
  display: flex;
  align-items: center;
  background: linear-gradient(135deg, #4A90D9 0%, #67B8DE 100%);
  border-radius: 20rpx;
  padding: 40rpx 30rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(74, 144, 217, 0.3);
}

.overview-score-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-right: 40rpx;
}

.score-number {
  font-size: 72rpx;
  font-weight: 700;
  color: #ffffff;
  line-height: 1;
}

.score-label {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
  margin-top: 8rpx;
}

.overview-divider {
  width: 2rpx;
  height: 80rpx;
  background-color: rgba(255, 255, 255, 0.3);
}

.overview-stats-section {
  flex: 1;
  padding-left: 40rpx;
}

.stats-row {
  margin-bottom: 12rpx;
}

.stats-row:last-child {
  margin-bottom: 0;
}

.overview-stars-new {
  display: flex;
}

.star-icon {
  font-size: 32rpx;
  color: #FFD700;
  margin-right: 4rpx;
}

.total-label {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.9);
}

/* 评价列表 */
.evaluation-list {
  background-color: #ffffff;
  border-radius: 20rpx;
  padding: 10rpx 24rpx;
}

.evaluation-item {
  padding: 24rpx 0;
  border-bottom: 1rpx solid var(--border-color);
}

.evaluation-item:last-child {
  border-bottom: none;
}

.evaluator-info {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.avatar-wrapper {
  width: 80rpx;
  height: 80rpx;
  margin-right: 16rpx;
}

.evaluator-info .avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background-color: var(--bg-color);
}

.avatar-default {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background-color: var(--bg-color);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
}

.evaluator-info .info {
  flex: 1;
}

.evaluator-info .nickname {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--text-primary);
  display: block;
  margin-bottom: 6rpx;
}

.evaluator-info .rating .star {
  font-size: 26rpx;
  color: #F7BA2A;
  padding: 0;
}

.evaluation-content {
  padding-left: 96rpx;
}

.evaluation-content .tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 12rpx;
}

.evaluation-content .tag {
  padding: 8rpx 20rpx;
  background-color: rgba(74, 144, 217, 0.1);
  color: var(--primary-color);
  border-radius: 20rpx;
  font-size: 24rpx;
}

.evaluation-content .comment {
  font-size: 28rpx;
  color: var(--text-regular);
  line-height: 1.7;
}

/* 空状态居中 */
.empty-state-center {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 50vh;
  padding: 40rpx;
}

.empty-state-center .empty-icon {
  font-size: 120rpx;
  margin-bottom: 30rpx;
}

.empty-state-center .empty-text {
  font-size: 32rpx;
  color: var(--text-primary);
  font-weight: 500;
  margin-bottom: 12rpx;
}

.empty-state-center .empty-tip {
  font-size: 26rpx;
  color: var(--text-secondary);
}

/* 加载状态 */
.loading-state {
  text-align: center;
  padding: 30rpx;
  font-size: 26rpx;
  color: var(--text-secondary);
}
