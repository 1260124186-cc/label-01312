/* pages/mySkills/mySkills.wxss */

.my-skills-page {
  min-height: 100vh;
  background-color: var(--bg-color);
  padding: 20rpx;
}

.skill-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.skill-card {
  background-color: #ffffff;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
}

.card-header {
  padding: 28rpx;
}

.title-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.type-badge {
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
  font-weight: 500;
}

.type-badge.skill {
  background-color: rgba(74, 144, 217, 0.1);
  color: var(--primary-color);
}

.type-badge.need {
  background-color: rgba(230, 162, 60, 0.1);
  color: var(--warning-color);
}

.status-badge {
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
}

.status-badge.active {
  background-color: rgba(103, 194, 58, 0.1);
  color: var(--secondary-color);
}

.status-badge.closed {
  background-color: rgba(144, 147, 153, 0.1);
  color: var(--info-color);
}

.status-badge.completed {
  background-color: rgba(74, 144, 217, 0.1);
  color: var(--primary-color);
}

.title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-primary);
  display: block;
  margin-bottom: 12rpx;
}

.description {
  font-size: 26rpx;
  color: var(--text-regular);
  line-height: 1.6;
}

.card-info {
  padding: 20rpx 28rpx;
  border-top: 1rpx solid var(--border-color);
  border-bottom: 1rpx solid var(--border-color);
}

.info-row {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
}

.info-row:last-child {
  margin-bottom: 0;
}

.info-item {
  flex: 1;
  display: flex;
  align-items: center;
}

.info-icon {
  font-size: 24rpx;
  margin-right: 8rpx;
}

.info-item .value {
  font-size: 24rpx;
  color: var(--text-secondary);
}

.card-actions {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 28rpx;
  gap: 20rpx;
}

.action-btn {
  flex: 1;
  height: 72rpx;
  line-height: 72rpx;
  border-radius: 36rpx;
  font-size: 28rpx;
  border: none;
  font-weight: 500;
  text-align: center;
  display: flex;
  align-items: center;
  justify-content: center;
}

.action-btn::after {
  border: none;
}

.action-btn.edit {
  background-color: rgba(74, 144, 217, 0.1);
  color: var(--primary-color);
}

.action-btn.close {
  background-color: rgba(144, 147, 153, 0.1);
  color: var(--info-color);
}

.action-btn.republish {
  background-color: rgba(103, 194, 58, 0.1);
  color: var(--secondary-color);
}

.action-btn.delete {
  background-color: rgba(245, 108, 108, 0.1);
  color: var(--danger-color);
}

/* 空状态居中 */
.empty-state-center {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 60vh;
  padding: 40rpx;
}

.empty-state-center .empty-icon {
  font-size: 120rpx;
  margin-bottom: 30rpx;
}

.empty-state-center .empty-text {
  font-size: 32rpx;
  color: var(--text-primary);
  font-weight: 500;
  margin-bottom: 12rpx;
}

.empty-state-center .empty-tip {
  font-size: 26rpx;
  color: var(--text-secondary);
  margin-bottom: 40rpx;
}

.empty-btn {
  background: linear-gradient(135deg, #4A90D9 0%, #67B8DE 100%);
  color: #ffffff;
  font-size: 28rpx;
  padding: 20rpx 80rpx;
  border-radius: 44rpx;
  border: none;
  font-weight: 500;
  display: flex;
  align-items: center;
  justify-content: center;
}

.empty-btn::after {
  border: none;
}

/* 加载状态 */
.loading-state {
  text-align: center;
  padding: 30rpx;
  font-size: 26rpx;
  color: var(--text-secondary);
}

/* 没有更多 */
.no-more {
  text-align: center;
  padding: 30rpx;
  font-size: 24rpx;
  color: var(--text-secondary);
}
