/* pages/match/match.wxss */

.match-page {
  min-height: 100vh;
  background-color: var(--bg-color);
  padding-bottom: 140rpx;
}

/* 类型切换 */
.type-switch {
  display: flex;
  padding: 20rpx;
  gap: 20rpx;
}

.type-item {
  flex: 1;
  background-color: #ffffff;
  border-radius: 16rpx;
  padding: 24rpx 20rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  border: 2rpx solid transparent;
  transition: all 0.3s ease;
}

.type-item.active {
  border-color: var(--primary-color);
  background-color: rgba(74, 144, 217, 0.05);
}

.type-icon {
  font-size: 40rpx;
  margin-bottom: 8rpx;
}

.type-text {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 4rpx;
}

.type-desc {
  font-size: 22rpx;
  color: var(--text-secondary);
}

.type-item.active .type-text {
  color: var(--primary-color);
}

/* 筛选区域 */
.filter-section {
  background-color: #ffffff;
  margin: 0 20rpx;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 20rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.result-count {
  font-size: 24rpx;
  font-weight: 400;
  color: var(--text-secondary);
}

.filter-item {
  margin-bottom: 24rpx;
}

.filter-label {
  font-size: 26rpx;
  color: var(--text-regular);
  margin-bottom: 12rpx;
  display: block;
}

.picker-box {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 80rpx;
  background-color: var(--bg-color);
  border-radius: 12rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  color: var(--text-primary);
}

.picker-box .arrow {
  font-size: 20rpx;
  color: var(--text-secondary);
}

.time-slots {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.time-slot {
  padding: 16rpx 28rpx;
  background-color: var(--bg-color);
  border-radius: 30rpx;
  font-size: 26rpx;
  color: var(--text-regular);
  border: 2rpx solid transparent;
  transition: all 0.3s ease;
}

.time-slot.selected {
  background-color: rgba(74, 144, 217, 0.1);
  border-color: var(--primary-color);
  color: var(--primary-color);
}

.filter-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 30rpx;
}

.reset-btn {
  flex: 1;
  height: 80rpx;
  background-color: var(--bg-color);
  color: var(--text-regular);
  font-size: 28rpx;
  border-radius: 40rpx;
  border: none;
}

.reset-btn::after {
  border: none;
}

.match-btn {
  flex: 2;
  height: 80rpx;
  background: linear-gradient(135deg, #4A90D9 0%, #67B8DE 100%);
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 500;
  border-radius: 40rpx;
  border: none;
}

.match-btn::after {
  border: none;
}

/* 结果区域 */
.result-section {
  margin: 0 20rpx;
}

.result-list {
  margin-top: 16rpx;
}

.result-card {
  background-color: #ffffff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
  display: flex;
  gap: 20rpx;
}

.result-card:active {
  opacity: 0.9;
}

.match-score {
  width: 80rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #4A90D9 0%, #67B8DE 100%);
  border-radius: 12rpx;
  padding: 16rpx 0;
}

.score-value {
  font-size: 36rpx;
  font-weight: 700;
  color: #ffffff;
}

.score-label {
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.8);
}

.card-content {
  flex: 1;
  min-width: 0;
}

.card-header {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.avatar-wrapper {
  width: 64rpx;
  height: 64rpx;
  margin-right: 12rpx;
}

.avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background-color: var(--bg-color);
}

.avatar-default {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background-color: var(--bg-color);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
}

.user-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.nickname {
  font-size: 26rpx;
  font-weight: 500;
  color: var(--text-primary);
}

.campus {
  font-size: 22rpx;
  color: var(--text-secondary);
}

.credit-badge {
  padding: 6rpx 16rpx;
  background-color: rgba(103, 194, 58, 0.1);
  border-radius: 16rpx;
  font-size: 22rpx;
  color: var(--secondary-color);
}

.card-body {
  margin-bottom: 12rpx;
}

.title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-primary);
  display: block;
  margin-bottom: 8rpx;
}

.description {
  font-size: 24rpx;
  color: var(--text-regular);
  line-height: 1.5;
}

.card-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.tags {
  display: flex;
  gap: 8rpx;
}

.tag {
  padding: 4rpx 12rpx;
  background-color: var(--bg-color);
  border-radius: 12rpx;
  font-size: 22rpx;
  color: var(--text-secondary);
}

.time {
  font-size: 22rpx;
  color: var(--text-secondary);
}

/* 空结果 */
.empty-result {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 40rpx;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.empty-text {
  font-size: 28rpx;
  color: var(--text-secondary);
  margin-bottom: 8rpx;
}

.empty-tip {
  font-size: 24rpx;
  color: var(--text-secondary);
}

/* 加载状态 */
.loading-more,
.no-more {
  text-align: center;
  padding: 30rpx;
  font-size: 24rpx;
  color: var(--text-secondary);
}

/* 初始提示 */
.init-tip {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 100rpx 40rpx;
}

.tip-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.tip-text {
  font-size: 30rpx;
  color: var(--text-primary);
  font-weight: 500;
  margin-bottom: 12rpx;
}

.tip-desc {
  font-size: 24rpx;
  color: var(--text-secondary);
  text-align: center;
  line-height: 1.6;
}
