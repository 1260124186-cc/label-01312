.container {
  min-height: 100vh;
  background-color: #f5f5f5;
  padding: 20rpx;
  box-sizing: border-box;
}

.header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx;
  margin-bottom: 20rpx;
}

.header .title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.header .mark-all {
  font-size: 28rpx;
  color: #4A90D9;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 100rpx 40rpx;
}

.empty-state .empty-icon {
  font-size: 120rpx;
  margin-bottom: 30rpx;
  opacity: 0.6;
}

.empty-state .empty-text {
  font-size: 28rpx;
  color: #999;
}

.message-list {
  background-color: #fff;
  border-radius: 16rpx;
  overflow: hidden;
}

.message-item {
  display: flex;
  align-items: center;
  padding: 30rpx;
  border-bottom: 1rpx solid #f0f0f0;
  position: relative;
}

.message-item.unread {
  background-color: #f0f7ff;
}

.message-item:last-child {
  border-bottom: none;
}

.message-icon {
  font-size: 40rpx;
  margin-right: 24rpx;
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: #f5f5f5;
  border-radius: 50%;
}

.message-content {
  flex: 1;
}

.message-title {
  font-size: 30rpx;
  color: #333;
  font-weight: 500;
  margin-bottom: 8rpx;
}

.message-desc {
  font-size: 26rpx;
  color: #666;
  line-height: 1.4;
  margin-bottom: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.message-time {
  font-size: 22rpx;
  color: #999;
}

.unread-dot {
  width: 16rpx;
  height: 16rpx;
  background-color: #ff4d4f;
  border-radius: 50%;
  position: absolute;
  right: 30rpx;
  top: 50%;
  transform: translateY(-50%);
}

.loading {
  text-align: center;
  padding: 30rpx;
  color: #999;
  font-size: 26rpx;
}
