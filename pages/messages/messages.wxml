<view class="container">
  <view class="header">
    <text class="title">消息通知</text>
    <text wx:if="{{isLogin && unreadCount > 0}}" class="mark-all" bindtap="markAllAsRead">全部已读</text>
  </view>

  <view wx:if="{{!isLogin}}" class="empty-state">
    <view class="empty-icon">🔒</view>
    <text class="empty-text">请登录后查看消息</text>
  </view>

  <view wx:elif="{{messages.length === 0}}" class="empty-state">
    <view class="empty-icon">🔔</view>
    <text class="empty-text">暂无消息</text>
  </view>

  <view wx:else class="message-list">
    <view
      wx:for="{{messages}}"
      wx:key="_id"
      class="message-item {{!item.isRead ? 'unread' : ''}}"
      bindtap="onMessageTap"
      data-id="{{item._id}}"
    >
      <view class="message-icon">
        <text>{{item.icon || '📬'}}</text>
      </view>
      <view class="message-content">
        <view class="message-title">{{item.title}}</view>
        <view class="message-body">{{item.content}}</view>
        <view class="message-time">{{item.createTimeStr}}</view>
      </view>
      <view wx:if="{{!item.isRead}}" class="unread-dot"></view>
      <view class="delete-btn" catchtap="deleteMessage" data-id="{{item._id}}">×</view>
    </view>
  </view>
</view>
