/* pages/detail/detail.wxss */

.detail-page {
  min-height: 100vh;
  background-color: var(--bg-color);
  padding-bottom: 140rpx;
}

/* 加载状态 */
.loading-container {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 400rpx;
}

.loading-text {
  font-size: 28rpx;
  color: var(--text-secondary);
}

/* 发布者卡片 */
.publisher-card {
  background-color: #ffffff;
  padding: 30rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.publisher-info {
  display: flex;
  align-items: center;
}

.avatar-wrapper {
  width: 100rpx;
  height: 100rpx;
  margin-right: 20rpx;
}

.avatar {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background-color: var(--bg-color);
}

.avatar-default {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background-color: var(--bg-color);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 50rpx;
}

.info {
  display: flex;
  flex-direction: column;
}

.nickname {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 8rpx;
}

.meta {
  font-size: 24rpx;
  color: var(--text-secondary);
}

.campus {
  margin-right: 20rpx;
}

.credit {
  color: var(--primary-color);
}

.type-badge {
  padding: 12rpx 24rpx;
  border-radius: 24rpx;
  font-size: 26rpx;
}

.type-badge.skill {
  background-color: rgba(103, 194, 58, 0.1);
  color: var(--secondary-color);
}

.type-badge.need {
  background-color: rgba(230, 162, 60, 0.1);
  color: var(--warning-color);
}

/* 技能详情卡片 */
.skill-detail-card {
  background-color: #ffffff;
  padding: 30rpx;
  margin: 0 20rpx;
  border-radius: 16rpx;
}

.skill-title {
  font-size: 36rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 30rpx;
  line-height: 1.4;
}

.info-row {
  display: flex;
  align-items: flex-start;
  margin-bottom: 20rpx;
}

.label {
  width: 160rpx;
  font-size: 28rpx;
  color: var(--text-secondary);
}

.value {
  flex: 1;
  font-size: 28rpx;
  color: var(--text-primary);
}

.time-tags {
  display: flex;
  flex-wrap: wrap;
  flex: 1;
  gap: 12rpx;
}

.time-tag {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 56rpx;
  padding: 8rpx 24rpx;
  background-color: rgba(74, 144, 217, 0.1);
  color: var(--primary-color);
  border-radius: 28rpx;
  font-size: 24rpx;
  font-weight: 500;
  text-align: center;
  box-sizing: border-box;
}

.time-tag text {
  display: block;
  line-height: 1.2;
}

.divider {
  height: 1rpx;
  background-color: var(--border-color);
  margin: 30rpx 0;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 16rpx;
}

.description {
  font-size: 28rpx;
  color: var(--text-regular);
  line-height: 1.8;
  white-space: pre-wrap;
}

.footer-info {
  display: flex;
  justify-content: space-between;
  margin-top: 30rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid var(--border-color);
  font-size: 24rpx;
  color: var(--text-secondary);
}

/* 底部操作栏 */
.action-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background-color: #ffffff;
  padding: 20rpx 30rpx;
  display: flex;
  gap: 20rpx;
  box-shadow: 0 -4rpx 12rpx rgba(0, 0, 0, 0.05);
}

.action-btn {
  flex: 1;
  height: 88rpx;
  border-radius: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: 500;
  border: none;
}

.action-btn::after {
  border: none;
}

.action-btn.primary {
  background: linear-gradient(135deg, #4A90D9 0%, #67B8DE 100%);
  color: #ffffff;
}

.action-btn.secondary {
  background-color: var(--bg-color);
  color: var(--text-primary);
}

.action-btn.danger {
  background-color: rgba(245, 108, 108, 0.1);
  color: var(--danger-color);
}

.action-btn.disabled {
  background-color: var(--bg-color);
  color: var(--text-secondary);
  opacity: 0.8;
}

/* 预约弹窗 */
.appointment-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: flex-end;
  justify-content: center;
  z-index: 1000;
}

.modal-content {
  width: 100%;
  background-color: #ffffff;
  border-radius: 32rpx 32rpx 0 0;
  max-height: 85vh;
  display: flex;
  flex-direction: column;
}

.modal-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 30rpx;
  border-bottom: 1rpx solid var(--border-color);
  flex-shrink: 0;
}

.modal-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.close-btn {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  color: var(--text-secondary);
}

.modal-body {
  padding: 30rpx;
  flex: 1;
  overflow-y: auto;
}

.form-group {
  margin-bottom: 30rpx;
}

.form-label {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--text-primary);
  margin-bottom: 16rpx;
  display: block;
}

.picker-box {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 88rpx;
  background-color: var(--bg-color);
  border-radius: 12rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  color: var(--text-regular);
}

.picker-box .arrow {
  font-size: 20rpx;
  color: var(--text-secondary);
}

.form-input {
  width: 100%;
  height: 88rpx;
  background-color: var(--bg-color);
  border-radius: 12rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.form-textarea {
  width: 100%;
  min-height: 160rpx;
  background-color: var(--bg-color);
  border-radius: 12rpx;
  padding: 24rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.modal-footer {
  padding: 20rpx 30rpx;
  padding-bottom: calc(40rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
  flex-shrink: 0;
}

.submit-btn {
  width: 100%;
  height: 96rpx;
  background: linear-gradient(135deg, #4A90D9 0%, #67B8DE 100%);
  color: #ffffff;
  font-size: 32rpx;
  font-weight: 500;
  border-radius: 48rpx;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
}

.submit-btn::after {
  border: none;
}
