<!--pages/profile/profile.wxml-->
<view class="profile-page">
  <!-- 用户信息卡片 -->
  <view class="user-card">
    <view class="user-info" wx:if="{{hasUserInfo}}">
      <view class="avatar-wrapper">
        <image class="avatar" src="{{userInfo.avatarUrl}}" mode="aspectFill" wx:if="{{userInfo.avatarUrl}}"></image>
        <view class="avatar-default" wx:else>
          <text>👤</text>
        </view>
      </view>
      <view class="info">
        <text class="nickname">{{userInfo.nickName || '未设置昵称'}}</text>
        <view class="campus-info" wx:if="{{userInfo.campus}}">
          <text class="campus">{{userInfo.campus}}</text>
          <text class="major" wx:if="{{userInfo.major}}"> · {{userInfo.major}}</text>
        </view>
        <view class="credit-score">
          <text class="label">信誉分：</text>
          <text class="score {{stats.creditScore >= 80 ? 'high' : stats.creditScore >= 60 ? 'medium' : 'low'}}">{{stats.creditScore}}</text>
        </view>
      </view>
    </view>
    
    <!-- 未登录状态 -->
    <view class="login-prompt" wx:else>
      <view class="avatar-placeholder-wrapper">
        <view class="avatar-default large">
          <text>👤</text>
        </view>
      </view>
      <view class="prompt-content">
        <text class="prompt-text">登录后享受更多功能</text>
        <button class="login-btn" bindtap="goLogin">
          微信登录
        </button>
      </view>
    </view>
  </view>

  <!-- 数据统计 -->
  <view class="stats-card">
    <view class="stats-item">
      <text class="stats-value">{{hasUserInfo ? stats.publishedSkills : 0}}</text>
      <text class="stats-label">发布技能</text>
    </view>
    <view class="stats-divider"></view>
    <view class="stats-item">
      <text class="stats-value">{{hasUserInfo ? stats.publishedNeeds : 0}}</text>
      <text class="stats-label">发布需求</text>
    </view>
    <view class="stats-divider"></view>
    <view class="stats-item">
      <text class="stats-value">{{hasUserInfo ? stats.completedExchanges : 0}}</text>
      <text class="stats-label">完成交换</text>
    </view>
  </view>

  <!-- 功能菜单 -->
  <view class="menu-card">
    <view class="menu-item" 
          wx:for="{{menuList}}" 
          wx:key="id" 
          bindtap="onMenuTap" 
          data-item="{{item}}">
      <view class="menu-left">
        <view class="menu-icon-wrapper {{item.id}}">
          <text class="menu-emoji">{{item.emoji}}</text>
        </view>
        <text class="menu-title">{{item.title}}</text>
      </view>
      <view class="menu-right">
        <!-- 消息未读红点 -->
        <view class="menu-badge" wx:if="{{item.id === 'myMessages' && unreadCount > 0}}">
          <text class="badge-text" wx:if="{{unreadCount > 99}}">99+</text>
          <text class="badge-text" wx:else>{{unreadCount}}</text>
        </view>
        <view class="menu-arrow">
          <text class="arrow">›</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 退出登录按钮 -->
  <view class="logout-section" wx:if="{{hasUserInfo}}">
    <button class="logout-btn" bindtap="logout">退出登录</button>
  </view>

  <!-- 底部提示 -->
  <view class="footer-tip">
    <text>技能交换 · 共享学习</text>
  </view>
</view>
